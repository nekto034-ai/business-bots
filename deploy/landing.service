[Unit]
Description=Landing site (Математика бизнеса)
After=network-online.target

[Service]
ExecStart=/usr/bin/node /opt/business-bots/sites/landing/server.js
Environment=PORT=8080
Environment=LEADS_FILE=/var/lib/landing/leads.jsonl
Environment=REVIEWS_DIR=/var/lib/landing/reviews
DynamicUser=yes
StateDirectory=landing
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
